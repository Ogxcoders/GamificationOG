# GamificationOG — environment template (copy to .env and adjust)

# ---- Database (SQLite; schema is portable to Postgres per master plan §89) ----
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Security: general rate limiting (0 = disabled) ----
GOG_RATE_LIMIT_MAX=0
GOG_RATE_LIMIT_WINDOW=60

# ---- Security: admin login lockout ----
GOG_LOGIN_MAX_FAILURES=10
GOG_LOGIN_WINDOW_MINUTES=15
GOG_LOGIN_LOCK_MINUTES=15

# ---- Observability: bearer token for /api/metrics (unset = 401) ----
GOG_METRICS_TOKEN=

# ---- SSO: session signing secret (required for OIDC SSO in production) ----
GOG_SSO_SECRET=
# AUTH_SECRET=

# ---- SSO: allow the built-in mock IdP outside production/dev (default: off) ----
GOG_ALLOW_MOCK_IDP=false

# ---- Docker first-boot ----
# GOG_AUTOSEED=true   # seed the Customer Zero reference project on first boot
