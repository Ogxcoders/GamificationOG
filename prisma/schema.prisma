// GamificationOG — Universal Gamification + Monetization Platform
// Canonical domain model per MASTER PLAN Section 5 (Canonical Domain Primitives)
// Conventions:
//  - SQLite backend: no native enums/JSON -> String fields validated in code,
//    JSON payload fields suffixed with "Json" store serialized JSON.
//  - Common Object Contract (Section 6): id/type/version/status/timestamps/metadata
//  - Lifecycle (Section 7): draft|validated|preview|approved|published|scheduled|active|paused|archived

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 1. TENANCY — Organization > Workspace > Project > Environment (Sec. 8)
// =====================================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active") // active | suspended | archived
  metadataJson String  @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaces  Workspace[]
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         String   @default("active")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Project {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  slug         String
  description  String?
  status       String   @default("active")
  timezone     String   @default("UTC")
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments      Environment[]
  eventSchemas      EventSchema[]
  rules             Rule[]
  progressionTracks ProgressionTrack[]
  challenges        Challenge[]
  achievements      Achievement[]
  rewards           Reward[]
  currencies        Currency[]
  items             Item[]
  leaderboards      Leaderboard[]
  segments          Segment[]
  featureFlags      FeatureFlag[]
  remoteConfigs     RemoteConfig[]
  experiments       Experiment[]
  streaks           Streak[]
  notificationTemplates NotificationTemplate[]
  apiKeys           ApiKey[]
  admins            ProjectAdmin[]
  seasons           Season[]
  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Environment {
  id          String   @id @default(cuid())
  projectId   String
  name        String // development | staging | production
  status      String   @default("active")
  metadataJson String  @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, name])
}

// =====================================================================
// 2. IDENTITY (Sec. 9) — AppUser + identities + API keys + admins
// =====================================================================

model AppUser {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  externalId     String
  displayName    String?
  isAnonymous    Boolean  @default(true)
  attributesJson String   @default("{}")
  status         String   @default("active") // active | banned | suspended | deleted
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  identities     UserIdentity[]
  events         Event[]
  progression    UserProgression[]
  challengeProgress ChallengeProgress[]
  userAchievements UserAchievement[]
  ledger         LedgerTransaction[]
  walletBalances WalletBalance[]
  userItems      UserItem[]
  leaderboardEntries LeaderboardEntry[]
  userStreaks    UserStreak[]
  notifications  Notification[]
  experimentAssignments ExperimentAssignment[]
  variables      UserVariable[]
  decisionTraces DecisionTrace[]
  sessions       AppSession[]
  @@unique([projectId, environmentId, externalId])
  @@index([projectId, environmentId])
}

model UserIdentity {
  id                String   @id @default(cuid())
  appUserId         String
  provider          String // anonymous | google | apple | email | oauth | oidc | custom | device
  providerAccountId String
  verified          Boolean  @default(false)
  metadataJson      String   @default("{}")
  linkedAt          DateTime @default(now())
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([appUserId])
}

model AppSession {
  id            String   @id @default(cuid())
  appUserId     String
  sessionToken  String   @unique
  deviceInfoJson String  @default("{}")
  startedAt     DateTime @default(now())
  lastActiveAt  DateTime @default(now())
  endedAt       DateTime?
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@index([appUserId])
}

model ApiKey {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String
  name          String
  keyPrefix     String
  keyHash       String   @unique
  scopesJson    String   @default("[]")
  status        String   @default("active")
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, environmentId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // owner | admin | editor | viewer
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AdminSession[]
  projectAdmins ProjectAdmin[]
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model ProjectAdmin {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String @default("editor")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
}

// =====================================================================
// 3. EVENT SYSTEM (Sec. 10) — schemas, events, idempotency, replay
// =====================================================================

model EventSchema {
  id            String   @id @default(cuid())
  projectId     String
  name          String // e.g. "task.completed"
  version       Int      @default(1)
  description   String?
  payloadSchemaJson String @default("{}") // JSON-schema-lite: { property: { type, required, min, max, enum } }
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, name, version])
  @@index([projectId, status])
}

model Event {
  id             String   @id @default(cuid())
  eventId        String   @unique // uuid supplied or generated
  eventType      String
  eventVersion   Int      @default(1)
  projectId      String
  environmentId  String
  actorId        String? // AppUser id
  subjectId      String?
  source         String   @default("api") // web_sdk | android_sdk | ios_sdk | server | api | simulator
  occurredAt     DateTime
  receivedAt     DateTime @default(now())
  correlationId  String?
  causationId    String?
  idempotencyKey String?
  payloadJson    String   @default("{}")
  metadataJson   String   @default("{}")
  status         String   @default("received") // received | processing | processed | failed | duplicate | skipped
  processingError String?
  isReplay       Boolean  @default(false)
  appUser        AppUser? @relation(fields: [actorId], references: [id])
  ruleExecutions RuleExecution[]
  decisionTraces DecisionTrace[]
  @@unique([projectId, environmentId, idempotencyKey])
  @@index([projectId, environmentId, eventType, occurredAt])
  @@index([projectId, environmentId, status])
  @@index([actorId])
}

// =====================================================================
// 4. RULE ENGINE (Sec. 13) — WHEN event / IF conditions / THEN actions
// =====================================================================

model Rule {
  id              String   @id @default(cuid())
  projectId       String
  environmentId   String
  name            String
  description     String?
  eventType       String   // WHEN
  conditionsJson  String   @default("{}") // IF
  actionsJson     String   @default("[]") // THEN [{ type, params }]
  priority        Int      @default(100)
  cooldownSeconds Int? // per user
  frequencyCap    Int? // per user per period
  frequencyPeriod String? // hour | day | week | month
  segmentId       String?
  validFrom       DateTime?
  validTo         DateTime?
  status          String   @default("active") // draft | active | paused | archived
  version         Int      @default(1)
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions      RuleExecution[]
  @@index([projectId, environmentId, eventType, status])
  @@index([projectId, environmentId, priority])
}

model RuleExecution {
  id              String   @id @default(cuid())
  ruleId          String
  eventId         String
  decisionTraceId String?
  matched         Boolean
  skippedReason   String? // cooldown | frequency_cap | segment | schedule | inactive
  actionsExecuted Int      @default(0)
  error           String?
  durationMs      Int      @default(0)
  executedAt      DateTime @default(now())
  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([ruleId, executedAt])
  @@index([eventId])
}

// =====================================================================
// 5. PROGRESSION (Sec. 20) — tracks, XP, levels
// =====================================================================

model ProgressionTrack {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  code           String   @default("default") // track key
  name           String
  type           String   @default("linear") // linear | exponential | custom
  baseXpPerLevel Int      @default(100)
  growthFactor   Float    @default(1.0)
  maxLevel       Int      @default(100)
  customFormulaJson String? // { "levelFormula": "floor(sqrt(xp/100))" }
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userProgression UserProgression[]
  @@unique([projectId, environmentId, code])
}

model UserProgression {
  id        String   @id @default(cuid())
  appUserId String
  trackId   String
  xp        Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
  appUser  AppUser         @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  track    ProgressionTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  @@unique([appUserId, trackId])
  @@index([trackId, level])
}

model UserVariable {
  id        String   @id @default(cuid())
  appUserId String
  key       String
  valueJson String
  updatedAt DateTime @updatedAt
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([appUserId, key])
}

// =====================================================================
// 6. CHALLENGES / QUESTS (Sec. 21-22)
// =====================================================================

model Challenge {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  name           String
  description    String?
  type           String   @default("one_time") // daily | weekly | monthly | one_time | timed | seasonal
  metricSource   String   @default("event_count") // event_count | event_sum | unique_entities | formula
  eventType      String
  payloadProperty String? // for event_sum
  target         Float
  conditionsJson String   @default("{}")
  rewardsJson    String   @default("[]") // [{ type, params }]
  startsAt       DateTime?
  endsAt         DateTime?
  repeatability  String   @default("repeatable") // one_time | repeatable
  segmentId      String?
  status         String   @default("active")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progress ChallengeProgress[]
  @@index([projectId, environmentId, status])
  @@index([projectId, environmentId, eventType])
}

model ChallengeProgress {
  id          String    @id @default(cuid())
  challengeId String
  appUserId   String
  progress    Float     @default(0)
  target      Float
  completed   Boolean   @default(false)
  completedAt DateTime?
  periodKey   String    @default("all") // date bucket for daily/weekly resets
  claimedAt   DateTime?
  updatedAt   DateTime  @updatedAt
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  appUser   AppUser    @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([challengeId, appUserId, periodKey])
  @@index([appUserId])
}

// =====================================================================
// 7. ACHIEVEMENTS (Sec. 23)
// =====================================================================

model Achievement {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  code           String
  name           String
  description    String?
  category       String   @default("general")
  type           String   @default("one_time") // one_time | repeatable | hidden | progressive | compound
  conditionsJson String   @default("{}")
  points         Int      @default(0)
  icon           String?
  rewardsJson    String   @default("[]")
  hidden         Boolean  @default(false)
  status         String   @default("active")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userAchievements UserAchievement[]
  @@unique([projectId, environmentId, code])
  @@index([projectId, environmentId, status])
}

model UserAchievement {
  id            String   @id @default(cuid())
  achievementId String
  appUserId     String
  progress      Float    @default(0)
  target        Float    @default(1)
  unlockedAt    DateTime?
  createdAt     DateTime @default(now())
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  appUser     AppUser     @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([achievementId, appUserId])
  @@index([appUserId])
}

// =====================================================================
// 8. STREAKS (Sec. 24) — cadence + grace + freeze via Time Engine
// =====================================================================

model Streak {
  id                String    @id @default(cuid())
  projectId         String
  environmentId     String
  key               String    @default("daily") // streak definition key
  name              String
  cadence           String    @default("daily") // daily | weekly | custom
  eventType         String    @default("streak.checkin")
  gracePeriodHours  Int       @default(0)
  freezeCount       Int       @default(0)
  milestonesJson    String    @default("[]") // [{ at: 7, rewardsJson: "[]" }]
  rewardMultiplierJson String @default("{}") // { "7": 1.5 }
  segmentId         String?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStreaks UserStreak[]
  @@unique([projectId, environmentId, key])
}

model UserStreak {
  id                String    @id @default(cuid())
  streakId          String
  appUserId         String
  currentCount      Int       @default(0)
  bestCount         Int       @default(0)
  lastQualifyingAt  DateTime?
  currentFreezeCount Int      @default(0)
  updatedAt         DateTime  @updatedAt
  streak Streak  @relation(fields: [streakId], references: [id], onDelete: Cascade)
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([streakId, appUserId])
  @@index([streakId, currentCount])
}

// =====================================================================
// 9. REWARDS (Sec. 26)
// =====================================================================

model Reward {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String
  code          String
  name          String
  description   String?
  type          String   @default("currency") // xp | points | currency | item | entitlement | badge | discount | custom
  configJson    String   @default("{}") // { currencyCode, amount, itemCode, quantity, xpAmount, trackCode }
  eligibilityJson String @default("{}")
  stackRule     String   @default("allow") // allow | replace | reject
  expiresAt     DateTime?
  status        String   @default("active")
  metadataJson  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, environmentId, code])
  @@index([projectId, environmentId, status])
}

// =====================================================================
// 10. ECONOMY (Sec. 27) — Ledger is source of truth; Wallet is projection
// =====================================================================

model Currency {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  code           String // e.g. coins, gems
  name           String
  type           String   @default("soft") // soft | hard | premium
  exchangeRate   Float    @default(1.0) // rate to soft currency
  capConfigJson  String   @default("{}") // { maxBalance, dailyEarnCap }
  initialBalance Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ledger   LedgerTransaction[]
  wallets  WalletBalance[]
  @@unique([projectId, environmentId, code])
}

model LedgerTransaction {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  appUserId      String
  currencyId     String
  amount         Float // signed: + earn / - spend
  type           String // earn | spend | transfer | refund | adjustment | grant | reversal
  reason         String?
  source         String   @default("rule") // rule | challenge | achievement | streak | admin | purchase | workflow
  reference      String? // rewardId / challengeId / ruleId
  correlationId  String?
  causationId    String?
  idempotencyKey String?
  balanceAfter   Float
  actorType      String   @default("system") // human | system | plugin | ai | automation
  actorId        String?
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  appUser  AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])
  @@unique([projectId, environmentId, idempotencyKey])
  @@index([appUserId, currencyId, createdAt])
  @@index([projectId, environmentId, createdAt])
}

model WalletBalance {
  id            String   @id @default(cuid())
  appUserId     String
  currencyId    String
  balance       Float    @default(0)
  lockedBalance Float    @default(0)
  updatedAt     DateTime @updatedAt
  appUser  AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  @@unique([appUserId, currencyId])
  @@index([currencyId, balance])
}

// =====================================================================
// 11. INVENTORY (Sec. 28)
// =====================================================================

model Item {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String
  code          String
  name          String
  description   String?
  type          String   @default("durable") // consumable | durable | cosmetic | bundle | virtual_good
  stackable     Boolean  @default(true)
  maxStack      Int      @default(999)
  icon          String?
  metadataJson  String   @default("{}")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userItems UserItem[]
  @@unique([projectId, environmentId, code])
  @@index([projectId, environmentId, status])
}

model UserItem {
  id          String    @id @default(cuid())
  appUserId   String
  itemId      String
  quantity    Int       @default(1)
  acquiredAt  DateTime  @default(now())
  expiresAt   DateTime?
  equipped    Boolean   @default(false)
  metadataJson String   @default("{}")
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([appUserId, itemId])
  @@index([appUserId])
}

// =====================================================================
// 12. LEADERBOARDS (Sec. 29)
// =====================================================================

model Leaderboard {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  code           String
  name           String
  metricSource   String   @default("event_sum") // event_count | event_sum | xp | currency | formula
  eventType      String?
  payloadProperty String?
  algorithm      String   @default("highest") // highest | lowest
  timeWindow     String   @default("all_time") // all_time | daily | weekly | monthly | seasonal
  tieBreaker     String   @default("earliest") // earliest | latest
  resetSchedule  String?
  maxEntries     Int      @default(1000)
  rewardsJson    String   @default("[]") // rank-based rewards [{ rankFrom, rankTo, rewardsJson }]
  status         String   @default("active")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries LeaderboardEntry[]
  @@unique([projectId, environmentId, code])
  @@index([projectId, environmentId, status])
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  leaderboardId String
  appUserId     String
  score         Float    @default(0)
  rank          Int?
  periodKey     String   @default("all")
  updatedAt     DateTime @updatedAt
  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  appUser     AppUser     @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([leaderboardId, appUserId, periodKey])
  @@index([leaderboardId, periodKey, score])
}

// =====================================================================
// 13. SEASONS (Sec. 31)
// =====================================================================

model Season {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  number       Int       @default(1)
  startsAt     DateTime
  endsAt       DateTime
  gracePeriodHours Int  @default(24)
  status       String    @default("scheduled") // scheduled | active | ended
  tracksJson   String    @default("[]") // reward tracks [{ name, tiers: [{ at, rewardsJson }] }]
  rankResetPolicy String @default("soft") // soft | hard | none
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, number])
}

// =====================================================================
// 14. SEGMENTS / EXPERIMENTS / FLAGS / REMOTE CONFIG (Sec. 33, 35, 36)
// =====================================================================

model Segment {
  id             String   @id @default(cuid())
  projectId      String
  environmentId  String
  name           String
  description    String?
  type           String   @default("dynamic") // static | dynamic
  conditionsJson String   @default("{}")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, environmentId, status])
}

model Experiment {
  id              String   @id @default(cuid())
  projectId       String
  environmentId   String
  key             String
  name            String
  description     String?
  variantsJson    String   @default("[]") // [{ key, name, weight }]
  trafficPercent  Int      @default(100)
  status          String   @default("draft") // draft | running | paused | completed
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments ExperimentAssignment[]
  @@unique([projectId, environmentId, key])
  @@index([projectId, environmentId, status])
}

model ExperimentAssignment {
  id            String   @id @default(cuid())
  experimentId  String
  appUserId     String
  variant       String
  assignedAt    DateTime @default(now())
  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  appUser     AppUser     @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@unique([experimentId, appUserId])
  @@index([appUserId])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  projectId       String
  environmentId   String
  key             String
  description     String?
  enabled         Boolean  @default(false)
  rolloutPercent  Int      @default(100)
  segmentsJson    String   @default("[]")
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, environmentId, key])
  @@index([projectId, environmentId, status])
}

model RemoteConfig {
  id            String   @id @default(cuid())
  projectId     String
  environmentId  String
  key           String
  valueType     String   @default("string") // string | number | boolean | json
  valueJson     String   @default("")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, environmentId, key])
}

// =====================================================================
// 15. NOTIFICATIONS (Sec. 75)
// =====================================================================

model NotificationTemplate {
  id            String   @id @default(cuid())
  projectId     String
  key           String
  name          String
  channel       String   @default("in_app") // in_app | push | email | webhook
  titleTemplate String
  bodyTemplate  String
  variablesJson String   @default("[]")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, key])
}

model Notification {
  id            String    @id @default(cuid())
  projectId     String
  environmentId String
  appUserId     String
  templateId    String?
  title         String
  body          String?
  channel       String    @default("in_app")
  type          String    @default("info") // info | achievement | reward | challenge | warning | system
  readAt        DateTime?
  sentAt        DateTime  @default(now())
  status        String    @default("sent") // queued | sent | failed | read
  metadataJson  String    @default("{}")
  correlationId String?
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  @@index([appUserId, sentAt])
  @@index([projectId, environmentId, sentAt])
}

// =====================================================================
// 16. ANALYTICS (Sec. 76) — daily aggregates as read models
// =====================================================================

model MetricDaily {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String
  dateKey       String // YYYY-MM-DD
  metricType    String // events_ingested | events_processed | active_users | rules_executed | xp_awarded | currency_earned | currency_spent | rewards_granted | achievements_unlocked | challenges_completed | notifications_sent | new_users
  dimension     String   @default("") // e.g. eventType or currency code
  value         Float    @default(0)
  updatedAt     DateTime @updatedAt
  @@unique([projectId, environmentId, dateKey, metricType, dimension])
  @@index([projectId, environmentId, metricType, dateKey])
}

// =====================================================================
// 17. DECISION TRACE + AUDIT (Sec. 70, 96)
// =====================================================================

model DecisionTrace {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String
  eventId       String
  correlationId String?
  appUserId     String?
  eventType     String
  source        String   @default("api")
  appUser       AppUser? @relation(fields: [appUserId], references: [id])
  stepsJson     String   @default("[]") // [{ step, name, input, output, matched, durationMs, detail }]
  summary       String?
  actionsCount  Int      @default(0)
  durationMs    Int      @default(0)
  createdAt     DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([projectId, environmentId, createdAt])
  @@index([appUserId])
  @@index([eventId])
}

model AuditLog {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String?
  actorType     String   @default("human") // human | system | plugin | ai | automation
  actorId       String?
  action        String // rule.created, currency.updated...
  targetType    String
  targetId      String?
  beforeJson    String?
  afterJson     String?
  reason        String?
  requestId     String?
  createdAt     DateTime @default(now())
  @@index([projectId, createdAt])
  @@index([targetType, targetId])
}

// =====================================================================
// 18. WEBHOOKS (Sec. 99)
// =====================================================================

model WebhookEndpoint {
  id            String   @id @default(cuid())
  projectId     String
  environmentId String
  url           String
  secret        String?
  eventsJson    String   @default("[]")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deliveries    WebhookDelivery[]
  @@index([projectId, environmentId])
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  endpointId    String
  eventId       String?
  eventType     String
  payloadJson   String   @default("{}")
  statusCode    Int?
  response      String?
  status        String   @default("pending") // pending | delivered | failed | retrying
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  @@index([endpointId, createdAt])
}
